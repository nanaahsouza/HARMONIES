# O Node não carrega .env automaticamente. Use: node --env-file=.env src/server/main.ts
PORT=3001
HOST=0.0.0.0
DATABASE_PATH=data/harmonies.sqlite
# Local: deixe vazio para validar Origin contra o Host recebido.
# Produção: copie a origem HTTPS real exibida pela plataforma, sem barra final.
PUBLIC_ORIGIN=
